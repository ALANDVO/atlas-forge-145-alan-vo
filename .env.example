# Application
APP_NAME=atlas-forge-145-alan-vo
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=atlas-forge
KEYCLOAK_CLIENT_ID=atlas-forge-client
KEYCLOAK_CLIENT_SECRET=
OIDC_ISSUER=http://localhost:8080/realms/atlas-forge
OIDC_AUDIENCE=atlas-forge-client

# LLM
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost

# Media server
MEDIA_RANGE_PIECE_BYTES=4194304
